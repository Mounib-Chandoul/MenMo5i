# === AI Provider Keys ===
# At least one is required. Gemini is recommended for a free working setup.

# Google Gemini 2.0 Flash — free tier (recommended)
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Hugging Face Inference Providers — free tier
# Requires a fine-grained token with "inference.serverless.write" permission
# Create one at: https://huggingface.co/settings/tokens
HF_API_TOKEN=

# Replicate — requires billing credit
# Get your token at: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
